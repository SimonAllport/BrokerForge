{
  "BrokerForge": {
    "DescriptorRoot": "../../descriptors",
    "ConnectBaseUrl": "http://localhost:5080/connect",
    "Trust": {
      "Mode": "Development"
    },
    "ServiceInstances": [
      {
        "Name": "OrdersAPI",
        "BrokerType": "rest",
        "BaseUrl": "http://localhost:4010",
        "AuthMode": "Static",
        "SecretReferences": {
          "apiKey": "env:ORDERS_API_KEY"
        },
        "Config": {
          "static.kind": "apiKeyHeader",
          "static.header": "X-Api-Key",
          "accountId": "acc-001",
          "tenantId": "tenant-dev"
        },
        "AllowedEnvironments": [ "local-dev" ]
      }
    ],
    "ObjectMaps": [
      {
        "ServiceInstance": "OrdersAPI",
        "Table": "ext_order",
        "KeyStrategy": "Reversible",
        "Operations": {
          "RetrieveMultiple": "listOrders",
          "Retrieve": "getOrder",
          "Create": "createOrder",
          "Update": "updateOrder",
          "Delete": "deleteOrder"
        }
      }
    ],
    "CustomApis": [
      {
        "ServiceInstance": "OrdersAPI",
        "UniqueName": "ext_SubmitOrder",
        "Operation": "submitOrder"
      }
    ]
  }
}
